msgstr "Registros: %1$d / %2$d"

msgid "Delete all history records?"
msgstr "¿Eliminar todos los registros del historial?"

msgid ""
"This only clears the URL change log. Your posts and the link list are not "
"changed."
msgstr ""
"Esto solo borra el registro de cambios de URL. Las entradas y la lista de "
"enlaces no se modifican."

msgid "Delete all history records"
msgstr "Eliminar todos los registros del historial"

